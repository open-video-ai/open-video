# Ensure sdists ship the metadata + shipped data the wheel includes.
include README.md
include PLAN.md
include ARCHITECTURE.md
include LICENSE
include pyproject.toml
# Keep the included tests runnable from the source distribution.
include tests/conftest.py
include bench/profile.py
include scripts/install.ps1 scripts/lab-restore.sh scripts/pinokio_install.js
recursive-include backends *.json
recursive-include library *.txt *.md
recursive-include docs *.md
prune .git
prune artifacts
global-exclude __pycache__
global-exclude *.py[cod]
