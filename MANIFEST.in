# Ensure sdists ship the metadata + shipped data the wheel includes.
include README.md
include PLAN.md
include ARCHITECTURE.md
include LICENSE
include pyproject.toml
recursive-include backends *.json
recursive-include library *.txt *.md
recursive-include docs *.md
prune .git
prune artifacts
global-exclude __pycache__
global-exclude *.py[cod]
recursive-include backends *.md
include scripts/install.sh
include scripts/h3_download.sh
include scripts/h3_aria2_list.txt
