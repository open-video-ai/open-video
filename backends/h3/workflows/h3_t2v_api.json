  "decode_video": {"class_type":"VAEDecode","inputs":{"samples":["sampler",0],"vae":["vae_video",0]}},
  "decode_audio": {"class_type":"VAEDecodeAudio","inputs":{"samples":["sampler",0],"vae":["vae_audio",0]}},
  "create_video": {"class_type":"CreateVideo","inputs":{"images":["decode_video",0],"fps":24.0,"audio":["decode_audio",0]}},
  "save_video": {"class_type":"SaveVideo","inputs":{"video":["create_video",0],"filename_prefix":"h3_t2v","format":"auto","codec":"auto"}}
