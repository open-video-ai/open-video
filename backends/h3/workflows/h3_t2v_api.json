{
  "load_unet": {"class_type":"UNETLoader","inputs":{"unet_name":"minimax_h3_fl2va_pruned_int8_convrot.safetensors","weight_dtype":"default"}},
  "sigmashift": {"class_type":"MiniMaxH3SigmaShift","inputs":{"model":["load_unet",0],"shift_video":12.0,"shift_audio":3.0}},
  "load_clip": {"class_type":"CLIPLoader","inputs":{"clip_name":"qwen3vl_32b_minimax_h3_int8_convrot.safetensors","type":"minimax","device":"default"}},
  "vae_video": {"class_type":"VAELoader","inputs":{"vae_name":"minimax_h3_video_vae_fp16.safetensors"}},
  "vae_audio": {"class_type":"VAELoader","inputs":{"vae_name":"minimax_h3_audio_vae_fp32.safetensors"}},
  "h3_i2v": {"class_type":"MiniMaxH3ImageToVideo","inputs":{"clip":["load_clip",0],"vae":["vae_video",0],"prompt":"A cinematic shot of waves crashing on a rocky shore at sunset, slow motion, detailed, natural light.","width":960,"height":544,"length":124}},
  "noise": {"class_type":"RandomNoise","inputs":{"noise_seed":42}},
